---
import Card from "../ui/Card.astro";
import { dateParts, longDate, shortTime } from "../../lib/format";
import type { EventItem } from "../../lib/types";

const API_URL = "http://localhost:3000";

let nextEvent: EventItem | null = null;
let error = false;

try {
	const res = await fetch(`${API_URL}/events`);
	if (!res.ok) throw new Error();
	const events: EventItem[] = await res.json();

	const now = new Date().toISOString();
	nextEvent = events
		.filter((e) => e.start_time >= now)
		.sort((a, b) => a.start_time.localeCompare(b.start_time))[0] ?? null;
} catch {
	error = true;
}

const parts = nextEvent ? dateParts(nextEvent.start_time) : null;
---

<Card class="p-6">
	<p class="font-mono text-xs tracking-[0.2em] uppercase text-muted mb-3">Nächstes Event</p>

	{error && <p class="text-muted font-mono text-sm">Nicht verfügbar</p>}

	{!error && !nextEvent && <p class="text-muted font-mono text-sm">Keine Events geplant</p>}

	{!error && nextEvent && parts && (
		<div class="flex items-start gap-4">
			<!-- Datumskachel -->
			<div class="shrink-0 size-14 rounded-ui bg-surface-2 border border-line grid place-content-center text-center">
				<span class="text-xl font-bold leading-none text-accent">{parts.day}</span>
				<span class="font-mono text-[10px] tracking-widest text-muted mt-1">{parts.month}</span>
			</div>

			<!-- Inhalt -->
			<div class="flex-1 min-w-0">
				<span class="font-semibold truncate block">{nextEvent.title}</span>
				<p class="font-mono text-xs text-muted mt-0.5">
					{longDate(nextEvent.start_time)} · {shortTime(nextEvent.start_time)} – {shortTime(nextEvent.end_time)}
				</p>
				{nextEvent.location && <p class="font-mono text-xs text-muted mt-0.5">{nextEvent.location}</p>}
				{nextEvent.host_name && <p class="font-mono text-xs text-muted mt-0.5">{nextEvent.host_name}</p>}
			</div>
		</div>
	)}
</Card>
