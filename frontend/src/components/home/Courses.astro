---
import { allPrograms } from "../../data/studiengaenge_e";
---

<section class="courses-box" aria-labelledby="courses-title">
	<h2 id="courses-title">Studiengänge</h2>
	<ul class="courses-list">
		{allPrograms.map((program) => (
			<li class="course-item">
				<a href={program.url} target="_blank" rel="noreferrer">
					<span class="course-code">{program.code}</span>
					<span class="course-name">{program.name}</span>
					<span class="course-level">{program.level}</span>
				</a>
			</li>
		))}
	</ul>
</section>

<style>
	.courses-box {
		padding: 1.25rem;   
		border: 1px solid #d8dee9;
		border-radius: 1rem;
		background: #fff;
		box-shadow: 0 6px 24px rgba(0, 0, 0, 0.06);
	}

	.courses-box h2 {
		margin: 0 0 1rem;
		font-size: 1.25rem;
	}

	.courses-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.75rem;
	}

	.course-item a {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.9rem 1rem;
		border-radius: 0.75rem;
		text-decoration: none;
		color: inherit;
		background: #f7f9fc;
		border: 1px solid #e6ebf2;
	}

	.course-code {
		font-weight: 700;
		min-width: 3rem;
	}

	.course-name {
		flex: 1;
	}

	.course-level {
		font-size: 0.875rem;
		color: #5b6472;
		white-space: nowrap;
	}

	@media (max-width: 640px) {
		.course-item a {
			flex-direction: column;
		}
	}
</style>
