---
// Generiert mit Claude Opus 4.8
import Card from "../ui/Card.astro";
import Badge from "../ui/Badge.astro";
import Button from "../ui/Button.astro";
import Courses from "./Courses.astro";
---

<Card class="p-8 lg:p-10 flex flex-col gap-6">
	<div class="flex flex-wrap gap-2">
		<Badge variant="accent">Fachschaft E · RWU</Badge>
		<Badge variant="muted">Informatik &amp; Elektrotechnik</Badge>
	</div>

	<h1 class="text-4xl sm:text-5xl font-extrabold leading-[1.1]">
		Deine <span class="text-accent">Fachschaft</span> für Informatik &amp; Elektrotechnik
	</h1>

	<p class="text-muted text-lg leading-relaxed max-w-md">
		Wir vertreten euch gegenüber Hochschule und Profs, organisieren Events, verleihen Equipment und
		sind für alle Fragen rund ums Studium da.
	</p>

	<div class="flex flex-wrap gap-3">
		<Button href="/member">Lern uns kennen</Button>
		<Button href="/events" variant="outline">Zu den Events</Button>
	</div>
	<div class="mt-6">
		<Courses />
	</div>
</Card>
