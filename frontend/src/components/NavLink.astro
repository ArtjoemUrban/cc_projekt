---
const { title, url, currentpath } = Astro.props;

const href = '/' + (url ?? '');

let isActive = false;
try {
  if (typeof currentpath === 'string') {
    isActive = currentpath === href || currentpath === ('/' + (url ?? ''));
  } else if (Astro.request) {
    const p = new URL(Astro.request.url).pathname;
    isActive = p === href;
  }
} catch (e) {
  isActive = false;
}
---

<a href={href} class="relative group">
  {title}
  {
    isActive ? (
      <span class="inline-block w-full h-[1px] bg-current absolute left-0 bottom-1">&nbsp;</span>
    ) : (
      <span class="inline-block w-0 h-[1px] bg-current absolute left-0 bottom-1 group-hover:w-full transition-[width] ease duration-300">&nbsp;</span>
    )
  }
</a>
