---
import Logo from "../layout/Logo.astro";
import Button from "../ui/Button.astro";

const inputClass =
	"w-full bg-surface-2 border border-line rounded-ui px-4 py-3 outline-none focus:border-accent transition-colors";
---

<div class="bg-surface border border-line rounded-ui-lg p-8 w-full max-w-md mx-auto">
	<div class="flex flex-col items-center text-center gap-3 mb-8">
		<Logo size={56} />
		<h1 class="font-display text-3xl font-bold">Anmelden</h1>
		<p class="text-muted text-sm">
			Nur für Fachschaftsmitglieder. Hier verwaltest du News, Events, Inventar &amp; mehr.
		</p>
	</div>

	<!-- Backend folgt – aktuell ohne Funktion -->
	<form class="flex flex-col gap-4">
		<label class="flex flex-col gap-1.5">
			<span class="text-sm font-medium">Benutzername</span>
			<input type="text" name="username" autocomplete="username" class={inputClass} />
		</label>
		<label class="flex flex-col gap-1.5">
			<span class="text-sm font-medium">Passwort</span>
			<input type="password" name="password" autocomplete="current-password" class={inputClass} />
		</label>
		<Button type="submit" class="mt-2 w-full">Einloggen</Button>
	</form>
</div>
