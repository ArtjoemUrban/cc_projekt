---
import Card from "../ui/Card.astro";
import type { BoardMember } from "../../lib/types";

interface Props {
	member: BoardMember;
}

const { member } = Astro.props;
---

<Card class="p-6 flex flex-col items-center justify-center text-center gap-3 h-full">
	{member.image_path && (
		<img
			src={member.image_path.startsWith("http") ? member.image_path : `http://localhost:3000${member.image_path}`}
			alt={member.name}
			class="size-20 rounded-full object-cover border border-line cursor-zoom-in"
			data-lightbox-src={member.image_path.startsWith("http") ? member.image_path : `http://localhost:3000${member.image_path}`}
			data-lightbox-alt={member.name}
		/>
	)}
	<div>
		<h3 class="font-semibold text-lg">{member.name}</h3>
		<p class="font-mono text-sm text-accent">{member.position}</p>
	</div>
	{member.description && (
		<p class="text-muted text-sm">{member.description}</p>
	)}
</Card>
