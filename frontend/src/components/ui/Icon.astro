---
// Generiert mit Claude Opus 4.8
import { icons, type IconName } from "../../lib/icons";

interface Props {
	name: IconName;
	size?: number;
	class?: string;
}

const { name, size = 20, class: cls } = Astro.props;
---

<svg
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={cls}
	aria-hidden="true"
	set:html={icons[name]}
/>
