---
// Generiert mit Claude Opus 4.8
import Icon from "../ui/Icon.astro";
import type { IconName } from "../../lib/icons";

interface Props {
	label: string;
	href: string;
	icon?: IconName;
	currentPath: string;
}

const { label, href, currentPath } = Astro.props;

const normalize = (p: string) => (p?.length > 1 ? p.replace(/\/$/, "") : p || "/");
const active = normalize(currentPath) === normalize(href);
---

<a
	href={href}
	class:list={[
		"inline-flex items-center gap-2 px-3.5 py-2 rounded-full text-sm font-medium transition-colors",
		active ? "bg-accent-soft text-accent" : "text-muted hover:text-text hover:bg-surface-2",
	]}
>
	{/* <Icon name={icon} size={16} /> */}
	<span>{label}</span>
</a>
