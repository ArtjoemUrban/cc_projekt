---
// Generiert mit Claude Opus 4.8
import FSELogoDark from "../../assets/FSE_Logo_SVG.svg";
import FSELogoLight from "../../assets/FSE_Logo_SVG_Black.svg";

interface Props {
	size?: number;
}

const { size = 40 } = Astro.props;
---

<div class="shrink-0 logo-container" style={`--logo-size: ${size}px`}>
	<img
		src={FSELogoLight.src}
		alt="Fachschaft EI Logo"
		class="logo-light"
	/>
	<img
		src={FSELogoDark.src}
		alt="Fachschaft EI Logo"
		class="logo-dark"
	/>
</div>

<style define:vars={{ logoSize: `${size}px` }}>
	.logo-container {
		width: var(--logo-size);
		height: var(--logo-size);
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.logo-light {
		width: 100%;
		height: 100%;
		display: block;
	}

	.logo-dark {
		display: none;
		width: 100%;
		height: 100%;
	}

	:global(.dark) .logo-light {
		display: none;
	}

	:global(.dark) .logo-dark {
		display: block;
	}
</style>
