---
import Icon from "../ui/Icon.astro";

interface Props {
	size?: number;
}

const { size = 40 } = Astro.props;
---

<span
	class="grid place-items-center rounded-ui-sm bg-surface-2 border border-line text-text shrink-0"
	style={`width:${size}px;height:${size}px`}
>
	<Icon name="logo" size={Math.round(size * 0.5)} />
</span>
