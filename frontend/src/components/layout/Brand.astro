---
import Logo from "./Logo.astro";

interface Props {
	href?: string;
}

const { href = "/" } = Astro.props;
---

<a href={href} class="flex items-center gap-3">
	<Logo />
	<span class="leading-tight">
		<span class="block font-semibold">Fachschaft EI</span>
		<span class="block text-[10px] tracking-[0.2em] uppercase text-muted font-mono">
			Informatik · Elektrotechnik
		</span>
	</span>
</a>
