---
// Generiert mit Claude Opus 4.8
import Brand from "./Brand.astro";
import NavLink from "./NavLink.astro";
import ThemeToggle from "./ThemeToggle.tsx";
import type { IconName } from "../../lib/icons";

interface Props {
	currentPath: string;
}

const { currentPath } = Astro.props;

const links: { label: string; href: string; icon: IconName }[] = [
	{ label: "Start", href: "/", icon: "home" },
	{ label: "Mitglieder", href: "/member", icon: "users" },
	{ label: "Events", href: "/events", icon: "calendar" },
	{ label: "Inventar", href: "/inventory", icon: "box" },
	{ label: "Öffnungszeiten", href: "/office-hours", icon: "clock" },
	{ label: "Anmelden", href: "/login", icon: "lock" },
];
---

<header class="sticky top-0 z-30 bg-bg/80 backdrop-blur border-b border-line">
	<div class="mx-auto max-w-6xl px-4 h-16 flex items-center gap-4">
		<Brand />
		<nav class="ml-auto hidden md:flex items-center gap-1">
			{links.map((link) => <NavLink {...link} currentPath={currentPath} />)}
		</nav>
		<ThemeToggle client:load />
	</div>
</header>
