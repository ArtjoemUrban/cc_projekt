---
import Card from "../ui/Card.astro";
import Badge from "../ui/Badge.astro";
import { getOpeningHours } from "../../lib/api/openingHours";

let openingHours;
let error = null;

try {
	openingHours = await getOpeningHours();
} catch (e) {
	error = e instanceof Error ? e.message : "Failed to load opening hours";
	openingHours = [];
}

// Wochentag 1=Mo .. 5=Fr -> heute Index. Sa/So => -1 (kein Highlight).
const today = new Date();
const weekday = today.getDay(); // 0=So, 1=Mo, ..., 6=Sa
const todayWeekday = weekday === 0 ? 0 : weekday; // Backend: 0=So, 1-6=Mo-Sa
---

<Card class="p-2 sm:p-3">
	{
		error ? (
			<p class="text-red-500">{error}</p>
		) : (
			<ul>
				{
					openingHours.map((day) => {
						const isToday = day.weekday === todayWeekday;
						const closed = day.hours === null;
						return (
							<li
								class:list={[
									"flex items-center justify-between gap-3 px-4 py-4 rounded-ui",
									isToday && "bg-accent-soft",
								]}
							>
								<span class="flex items-center gap-3">
									{isToday && <Badge variant="solid">Heute</Badge>}
									<span class:list={["font-medium", isToday && "text-accent"]}>{day.name}</span>
								</span>
								<span
									class:list={[
										"font-mono text-sm",
										closed ? "text-muted" : isToday ? "text-accent" : "text-muted",
									]}
								>
									{closed ? "geschlossen" : day.hours}
								</span>
							</li>
						);
					})
				}
			</ul>
		)
	}
</Card>
