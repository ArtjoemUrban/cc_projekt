---

import '../styles/global.css'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'

const { title = "Fachschaft" } = Astro.props;

const currentpath = (() => {
  try {
    if (Astro.request) return new URL(Astro.request.url).pathname;
  } catch (e) {}
  return '/';
})();

---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <link rel="icon" href="/fse-logo-favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#9635e6" />
  <title>{title}</title>
  <script is:inline>
    if (localStorage.getItem('theme') === 'dark' ||
      (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    }
  </script>
</head>
<body class="transition-colors">
  <Header currentPath={currentpath} />
  <main class="px-4 py-6 md:px-8 md:py-8">
    <slot />
  </main>
  <Footer />
</body>

</html>