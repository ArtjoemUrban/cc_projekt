---

import '../styles/global.css'
import NavLink from '../components/NavLink.astro'

const { title = "Fachschaft" } = Astro.props;

const currentpath = (() => {
  try {
    if (Astro.request) return new URL(Astro.request.url).pathname;
  } catch (e) {}
  return '/';
})();

---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <title>{title}</title>
  <script is:inline>
    if (localStorage.getItem('theme') === 'dark' ||
      (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    }
  </script>
</head>
<body class="transition-colors">
  <nav class="flex items-center gap-4 px-4 py-3 border-b border-gray-200 dark:border-gray-700">
    <NavLink title="Start" url="" currentpath={currentpath} />
    <NavLink title="Mitglieder" url="member" currentpath={currentpath} />
    <NavLink title="Events" url="events" currentpath={currentpath} />
    <NavLink title="Inventar" url="inventory" currentpath={currentpath} />
    <NavLink title="Öffnungszeiten" url="office-hours" currentpath={currentpath} />
    <button
      id="theme-toggle"
      class="ml-auto text-xl"
      aria-label="Dark Mode umschalten"
    >🌙</button>
  </nav>

  <main>
    <slot />
  </main>

  <script>
    const btn = document.getElementById('theme-toggle')!;
    const html = document.documentElement;

    function updateIcon() {
      btn.textContent = html.classList.contains('dark') ? '☀️' : '🌙';
    }

    updateIcon();

    btn.addEventListener('click', () => {
      html.classList.toggle('dark');
      localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
      updateIcon();
    });
  </script>
</body>
</html>
