---
// Generiert mit Claude Opus 4.8
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {
	title?: string;
	/** Header/Footer ausblenden (z. B. für Fokus-Seiten). */
	chrome?: boolean;
}

const { title = "Fachschaft E", chrome = true } = Astro.props;
const currentPath = new URL(Astro.request.url).pathname;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<!-- Dark Mode ist Standard; nur bei expliziter Wahl "light" abschalten -->
		<script is:inline>
			if (localStorage.getItem("theme") !== "light") {
				document.documentElement.classList.add("dark");
			}
		</script>
	</head>
	<body class="min-h-screen flex flex-col bg-bg text-text antialiased">
		{chrome && <Header currentPath={currentPath} />}
		<main class="flex-1 w-full mx-auto max-w-6xl px-4 py-10">
			<slot />
		</main>
		{chrome && <Footer />}
	</body>

  </html>
