---
// Generiert mit Claude Opus 4.8
import Layout from "../layouts/Layout.astro";
import Card from "../components/ui/Card.astro";
import Hero from "../components/home/Hero.astro";
import RoomStatusCard from "../components/home/RoomStatusCard.astro";
import NextEventCard from "../components/home/NextEventCard.astro";
import LocationCard from "../components/office/LocationCard.astro";
import gruppenbild from "../assets/based_man.jpg";
---

<Layout title="Fachschaft E ">
	<div class="grid lg:grid-cols-2 gap-6">
		<Hero />

		<div class="flex flex-col gap-6">
			<Card class="overflow-hidden">
				<img src={gruppenbild.src} alt="Fachschaftsgruppenbild" class="w-full h-200 object-cover object-[center_300%]" />
			</Card>
			<RoomStatusCard />
			<NextEventCard />
			<LocationCard />
			
		</div>
	</div>
</Layout>
