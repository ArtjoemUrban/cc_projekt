---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import NextEventCard from "../components/home/NextEventCard.astro";
import RoomStatusCard from "../components/home/RoomStatusCard.astro";
import LocationCard from "../components/office/LocationCard.astro";
import { Image } from "astro:assets";
import gruppenbild from "../assets/FSE_Guppenbild.jpeg";
import logoLight from "../assets/FSE_Logo_SVG_Black.svg";
import logoDark from "../assets/FSE_Logo_SVG.svg";
---

<Layout title="Fachschaft E">
	<!-- Bild mit Titel-Overlap -->
	<div class="relative mb-8">
		<div class="rounded-ui-lg overflow-hidden relative">
			<Image
				src={gruppenbild}
				alt="Fachschaftsgruppenbild"
				class="w-full h-64 sm:h-80 lg:h-120 object-cover object-center"
				fetchpriority="high"
				loading="eager"
			/>
			<div class="absolute inset-x-0 bottom-0 h-32 bg-linear-to-t from-bg to-transparent pointer-events-none" />
		</div>
		<h1 class="relative z-10 -mt-20 sm:-mt-24 text-4xl sm:text-5xl font-extrabold leading-[1.1]">
			Deine <span class="text-accent">Fachschaft</span><br />für Informatik &amp; Elektrotechnik
		</h1>
	</div>

	<!-- Text + Logo -->
	<div class="grid lg:grid-cols-2 gap-6 mb-6 items-center">
		<div class="flex flex-col gap-5">
			<p class="text-muted text-lg leading-relaxed">
				Wir sind die Fachschaft des Fachbereichs Elektrotechnik und Informatik.
				Was zur Hölle wir machen? Das hängt ganz davon ab, wer so alles in der Fachschaft sitzt und wie sehr sich die Personen engagieren.
				Die Fachschaft blüht momentan stark auf und freut sich über jeden weiteren, der Bock darauf hat geile Events zu organisieren oder
				bereits Vorhandenes tatkräftig zu unterstützen.
			</p>
			<div class="flex flex-wrap gap-3">
				<Button href="/fachschaft">Mehr über uns</Button>
				<Button href="/events" variant="outline">Zu den Events</Button>
				<Button href="/inventory" variant="outline">Verleih</Button>
				<Button
					href="https://www.instagram.com/fachschaft_e/"
					variant="ghost"
					target="_blank"
					rel="noopener noreferrer"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
						<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
						<line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
					</svg>
					Instagram
				</Button>
			</div>
		</div>
		<div class="hidden lg:flex justify-center items-center py-4">
			<img src={logoLight.src} alt="Fachschaft Logo" class="w-full max-w-xs dark:hidden" />
			<img src={logoDark.src} alt="Fachschaft Logo" class="w-full max-w-xs hidden dark:block" />
		</div>
	</div>

	<!-- Event + Karte + Öffnungszeiten -->
	<div class="grid lg:grid-cols-3 gap-6">
		<NextEventCard />
		<RoomStatusCard />
		<LocationCard />
	</div>
</Layout>
