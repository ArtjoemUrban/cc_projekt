---
// Generiert mit Claude Opus 4.8
import Layout from "../layouts/Layout.astro";
import Card from "../components/ui/Card.astro";
import Hero from "../components/home/Hero.astro";
import Courses from "../components/home/Courses.astro";
import RoomStatusCard from "../components/home/RoomStatusCard.astro";
import gruppenbild from "../assets/FSE_Guppenbild.jpeg";
---

<Layout title="Fachschaft E ">
	<div class="grid lg:grid-cols-2 gap-6">
		<Hero />
		

		<div class="flex flex-col gap-6">
			<!-- Platz für ein Foto / eine Grafik -->
			<Card class="flex-1 min-h-64 grid place-items-center text-muted font-mono text-sm overflow-hidden">
				<img src={gruppenbild.src} alt="Fachschaftsgruppenbild" class="w-full h-full object-cover rounded-ui-lg" />
			</Card>
			<RoomStatusCard open={true} hours="11:00 – 13:00 Uhr" />
		</div>
	</div>
</Layout>
