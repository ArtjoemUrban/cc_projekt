<-- Generiert mit Claude AI -->

---
import Layout from "../layouts/Layout.astro";
import { getInventory } from "../lib/api.ts";

const items = await getInventory();

// Kategorien für Filter sammeln
const categories: string[] = [...new Set<string>(items.map((i: any) => i.category).filter(Boolean))];
---

<Layout title="Inventar">
  <div class="max-w-5xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-2">Inventar</h1>
    <p class="text-gray-500 mb-6">{items.length} Gegenstände insgesamt</p>

    <!-- Kategorie-Filter -->
    <div class="flex flex-wrap gap-2 mb-8">
      <button
        class="category-btn px-3 py-1 rounded-full text-sm font-medium bg-gray-800 text-white"
        data-category="all"
      >
        Alle
      </button>
      {categories.map((cat) => (
        <button
          class="category-btn px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors"
          data-category={cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Item-Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="inventory-grid">
      {items.map((item: any) => (
        <div
          class="inventory-card bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-5 flex flex-col gap-3 hover:shadow-md transition-shadow"
          data-category={item.category}
        >
          <!-- Header: Name + Kategorie-Badge -->
          <div class="flex items-start justify-between gap-2">
            <h2 class="font-semibold text-gray-900 dark:text-white leading-tight">{item.name}</h2>
            {item.category && (
              <span class="shrink-0 text-xs font-medium bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full">
                {item.category}
              </span>
            )}
          </div>

          <!-- Beschreibung -->
          {item.description && (
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">{item.description}</p>
          )}

          <!-- Footer: Menge + Ausleihe-Badge -->
          <div class="mt-auto flex items-center justify-between pt-2 border-t border-gray-100 dark:border-gray-700">
            <span class={`text-sm font-medium ${item.quantity_available > 0 ? "text-green-600" : "text-red-500"}`}>
              {item.quantity_available > 0
                ? `${item.quantity_available} / ${item.quantity} verfügbar`
                : "nicht verfügbar"}
            </span>
            {item.is_for_borrow === 1 && (
              <span class="text-xs bg-amber-100 text-amber-700 px-2 py-0.5 rounded-full font-medium">
                ausleihbar
              </span>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".category-btn");
  const cards = document.querySelectorAll<HTMLElement>(".inventory-card");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const selected = btn.dataset.category;

      // Aktiven Button hervorheben
      buttons.forEach((b) => {
        b.classList.remove("bg-gray-800", "text-white");
        b.classList.add("bg-gray-100", "text-gray-700");
      });
      btn.classList.add("bg-gray-800", "text-white");
      btn.classList.remove("bg-gray-100", "text-gray-700");

      // Karten filtern
      cards.forEach((card) => {
        if (selected === "all" || card.dataset.category === selected) {
          card.style.display = "";
        } else {
          card.style.display = "none";
        }
      });
    });
  });
</script>
