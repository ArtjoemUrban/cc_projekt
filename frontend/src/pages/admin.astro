---
// Generiert mit Claude Opus 4.8
import Layout from "../layouts/Layout.astro";
import Icon from "../components/ui/Icon.astro";

const inputClass =
	"w-full bg-surface-2 border border-line rounded-ui px-3 py-2 outline-none focus:border-accent transition-colors text-sm";
const labelClass = "flex flex-col gap-1 text-sm";
const tabClass =
	"px-4 py-2 rounded-full text-sm font-medium transition-colors text-muted hover:text-text hover:bg-surface-2 cursor-pointer";
const sectionClass = "flex flex-col gap-6";
const cardClass = "bg-surface border border-line rounded-ui-lg p-5";
const btnPrimary =
	"inline-flex items-center justify-center gap-2 px-4 py-2 rounded-ui font-medium text-sm bg-accent text-accent-contrast hover:bg-accent-strong transition-colors cursor-pointer";
const btnOutline =
	"inline-flex items-center justify-center gap-2 px-3 py-1.5 rounded-ui text-sm border border-line text-text hover:bg-surface-2 transition-colors cursor-pointer";
---

<Layout title="Admin Panel">
	<!-- Solange nicht verifiziert: Inhalt verstecken (Guard im Script) -->
	<div id="admin-guard" class="min-h-[50vh] grid place-items-center text-muted">
		<p>Lade…</p>
	</div>

	<div id="admin-app" class="hidden flex-col gap-8">
		<header class="flex flex-wrap items-center justify-between gap-4">
			<div>
				<p class="text-accent text-sm font-medium uppercase tracking-wide">Verwaltung</p>
				<h1 class="font-display text-3xl font-bold">Admin Panel</h1>
			</div>
			<div class="flex items-center gap-3">
				<span class="text-sm text-muted">Angemeldet als <strong id="admin-username" class="text-text"></strong></span>
				<button id="logout-btn" class={btnOutline}>
					<Icon name="logout" size={16} /> Abmelden
				</button>
			</div>
		</header>

		<!-- Tabs -->
		<div class="flex flex-wrap gap-2 border-b border-line pb-3" role="tablist">
			<button class={tabClass} data-tab="events">Events</button>
			<button class={tabClass} data-tab="inventory">Inventar</button>
			<button class={tabClass} data-tab="hours">Öffnungszeiten</button>
			<button class={tabClass} data-tab="board">Boardmitglieder</button>
			<button class={tabClass} data-tab="users">Benutzer</button>
		</div>

		<!-- globale Meldung -->
		<p id="admin-flash" class="hidden text-sm rounded-ui px-4 py-2"></p>

		<!-- ============ EVENTS ============ -->
		<section data-panel="events" class={sectionClass}>
			<div class={cardClass}>
				<h2 class="font-display text-xl font-bold mb-4" id="event-form-title">Neues Event</h2>
				<form id="event-form" class="grid sm:grid-cols-2 gap-4">
					<input type="hidden" name="id" />
					<label class={labelClass + " sm:col-span-2"}>
						<span class="font-medium">Titel</span>
						<input class={inputClass} name="title" required />
					</label>
					<label class={labelClass}>
						<span class="font-medium">Start</span>
						<input class={inputClass} type="datetime-local" name="start_time" required />
					</label>
					<label class={labelClass}>
						<span class="font-medium">Ende</span>
						<input class={inputClass} type="datetime-local" name="end_time" required />
					</label>
					<label class={labelClass}>
						<span class="font-medium">Ort</span>
						<input class={inputClass} name="location" />
					</label>
					<label class={labelClass}>
						<span class="font-medium">Veranstalter:in</span>
						<input class={inputClass} name="host_name" />
					</label>
					<label class={labelClass + " sm:col-span-2"}>
						<span class="font-medium">Beschreibung</span>
						<textarea class={inputClass} name="description" rows="2"></textarea>
					</label>
					<div class="sm:col-span-2 flex gap-2">
						<button type="submit" class={btnPrimary}>Speichern</button>
						<button type="button" data-reset class={btnOutline}>Abbrechen</button>
					</div>
				</form>
			</div>
			<div id="event-list" class="flex flex-col gap-3"></div>
		</section>

		<!-- ============ INVENTAR ============ -->
		<section data-panel="inventory" class={sectionClass + " hidden"}>
			<div class={cardClass}>
				<h2 class="font-display text-xl font-bold mb-4" id="inv-form-title">Neuer Inventar-Artikel</h2>
				<form id="inv-form" class="grid sm:grid-cols-2 gap-4">
					<input type="hidden" name="id" />
					<label class={labelClass}>
						<span class="font-medium">Name</span>
						<input class={inputClass} name="name" required />
					</label>
					<label class={labelClass}>
						<span class="font-medium">Kategorie</span>
						<input class={inputClass} name="category" required />
					</label>
					<label class={labelClass}>
						<span class="font-medium">Menge</span>
						<input class={inputClass} type="number" min="0" name="quantity" required />
					</label>
					<label class={labelClass}>
						<span class="font-medium">Bild-URL</span>
						<input class={inputClass} name="picture_url" />
					</label>
					<label class={labelClass + " sm:col-span-2"}>
						<span class="font-medium">Beschreibung</span>
						<textarea class={inputClass} name="description" rows="2"></textarea>
					</label>
					<label class="flex items-center gap-2 text-sm sm:col-span-2">
						<input type="checkbox" name="is_for_borrow" checked />
						<span>Verleihbar</span>
					</label>
					<div class="sm:col-span-2 flex gap-2">
						<button type="submit" class={btnPrimary}>Speichern</button>
						<button type="button" data-reset class={btnOutline}>Abbrechen</button>
					</div>
				</form>
			</div>
			<div id="inv-list" class="flex flex-col gap-3"></div>
		</section>

		<!-- ============ ÖFFNUNGSZEITEN ============ -->
		<section data-panel="hours" class={sectionClass + " hidden"}>
			<div class={cardClass}>
				<h2 class="font-display text-xl font-bold mb-1">Öffnungszeiten</h2>
				<p class="text-muted text-sm mb-4">Leerlassen bzw. 00:00–00:00 = geschlossen.</p>
				<div id="hours-list" class="flex flex-col gap-3"></div>
			</div>
		</section>

		<!-- ============ BOARDMITGLIEDER ============ -->
		<section data-panel="board" class={sectionClass + " hidden"}>
			<div class={cardClass}>
				<h2 class="font-display text-xl font-bold mb-4" id="board-form-title">Neues Boardmitglied</h2>
				<form id="board-form" class="grid sm:grid-cols-2 gap-4">
					<input type="hidden" name="id" />
					<label class={labelClass}>
						<span class="font-medium">Name</span>
						<input class={inputClass} name="name" required />
					</label>
					<label class={labelClass}>
						<span class="font-medium">Position</span>
						<input class={inputClass} name="position" required placeholder="z. B. 1. Vorsitzende:r" />
					</label>
					<label class={labelClass + " sm:col-span-2"}>
						<span class="font-medium">Beschreibung</span>
						<textarea class={inputClass} name="description" rows="2" placeholder="Studiengang, Bio, …"></textarea>
					</label>
					<div class={labelClass}>
						<span class="font-medium">Bild</span>
						<div class="flex items-center gap-3">
							<img id="board-img-preview" src="" alt="" class="hidden size-14 rounded-full object-cover border border-line" />
							<label class={"cursor-pointer " + btnOutline}>
								Bild auswählen
								<input type="file" id="board-img-file" accept="image/*" class="sr-only" />
							</label>
						</div>
						<input type="hidden" name="image_path" />
					</div>
					<label class={labelClass}>
						<span class="font-medium">Reihenfolge</span>
						<input class={inputClass} type="number" name="sort_order" value="0" min="0" />
					</label>
					<label class="flex items-center gap-2 text-sm sm:col-span-2">
						<input type="checkbox" name="visible" checked />
						<span>Sichtbar auf der Mitgliederseite</span>
					</label>
					<div class="sm:col-span-2 flex gap-2">
						<button type="submit" class={btnPrimary}>Speichern</button>
						<button type="button" data-reset class={btnOutline}>Abbrechen</button>
					</div>
				</form>
			</div>
			<div id="board-list" class="flex flex-col gap-3"></div>
		</section>

		<!-- ============ BENUTZER ============ -->
		<section data-panel="users" class={sectionClass + " hidden"}>
			<div class={cardClass}>
				<h2 class="font-display text-xl font-bold mb-4">Neues Mitglied anlegen</h2>
				<form id="user-form" class="grid sm:grid-cols-2 gap-4">
					<label class={labelClass}>
						<span class="font-medium">Vorname</span>
						<input class={inputClass} name="prename" required />
					</label>
					<label class={labelClass}>
						<span class="font-medium">Nachname</span>
						<input class={inputClass} name="surname" required />
					</label>
					<label class={labelClass}>
						<span class="font-medium">E-Mail</span>
						<input class={inputClass} type="email" name="email" required />
					</label>
					<label class={labelClass}>
						<span class="font-medium">Benutzername</span>
						<input class={inputClass} name="username" required />
					</label>
					<label class={labelClass + " sm:col-span-2"}>
						<span class="font-medium">Passwort</span>
						<input class={inputClass} type="password" name="password" required />
					</label>
					<div class="sm:col-span-2">
						<button type="submit" class={btnPrimary}>Anlegen</button>
					</div>
				</form>
			</div>
			<div id="user-list" class={cardClass + " overflow-x-auto"}></div>
		</section>
	</div>
</Layout>

<script>
	import {
		getMe,
		getEvents,
		createEvent,
		updateEvent,
		deleteEvent,
		getInventory,
		createInventoryItem,
		updateInventoryItem,
		deleteInventoryItem,
		getOpeningHours,
		updateOpeningHours,
		getUsers,
		registerUser,
		changeUserRole,
		deleteUser,
		getAllBoardMembers,
		createBoardMember,
		updateBoardMember,
		deleteBoardMember,
		uploadBoardMemberImage,
	} from "../lib/api";
	import { getPayload, clearToken } from "../lib/auth";

	const guard = document.getElementById("admin-guard")!;
	const appEl = document.getElementById("admin-app")!;
	const flash = document.getElementById("admin-flash")!;

	function showFlash(msg: string, ok = true) {
		flash.textContent = msg;
		flash.className =
			"text-sm rounded-ui px-4 py-2 " +
			(ok ? "bg-accent-soft text-accent" : "bg-red-500/10 text-red-500");
		flash.classList.remove("hidden");
		setTimeout(() => flash.classList.add("hidden"), 4000);
	}

	/** Feldzugriff für Felder, deren Name mit HTMLFormElement-Properties kollidiert (id, title, name). */
	function field(form: HTMLFormElement, name: string): HTMLInputElement {
		return form.elements.namedItem(name) as HTMLInputElement;
	}

	function esc(v: unknown): string {
		return String(v ?? "")
			.replace(/&/g, "&amp;")
			.replace(/</g, "&lt;")
			.replace(/>/g, "&gt;")
			.replace(/"/g, "&quot;");
	}

	/* --------------------------- Guard --------------------------- */
	async function boot() {
		const payload = getPayload();
		if (!payload) {
			window.location.href = "/login";
			return;
		}
		try {
			const me: any = await getMe(); // verifiziert Token serverseitig
			if (me.role !== "admin") {
				guard.innerHTML =
					'<div class="text-center"><p class="mb-2">Kein Zugriff – dieser Bereich ist nur für Admins.</p>' +
					'<div class="flex gap-4 justify-center mt-2">' +
					'<a class="text-accent underline" href="/">Zur Startseite</a>' +
					'<button id="guard-logout-btn" class="text-accent underline">Abmelden</button>' +
					'</div></div>';
				document.getElementById("guard-logout-btn")!.addEventListener("click", () => {
					clearToken();
					window.location.href = "/login";
				});
				return;
			}
			document.getElementById("admin-username")!.textContent = me.username;
		} catch {
			clearToken();
			window.location.href = "/login";
			return;
		}

		guard.classList.add("hidden");
		appEl.classList.remove("hidden");
		appEl.classList.add("flex");
		setupTabs();
		setupLogout();
		setupEvents();
		setupInventory();
		setupHours();
		setupBoard();
		setupUsers();
		loadEvents();
	}

	/* ---------------------------- Tabs ---------------------------- */
	function setupTabs() {
		const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tab]"));
		const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-panel]"));
		const loaders: Record<string, () => void> = {
			events: loadEvents,
			inventory: loadInventory,
			hours: loadHours,
			board: loadBoard,
			users: loadUsers,
		};
		const activate = (name: string) => {
			tabs.forEach((t) => {
				const on = t.dataset.tab === name;
				t.classList.toggle("bg-accent-soft", on);
				t.classList.toggle("text-accent", on);
			});
			panels.forEach((p) => p.classList.toggle("hidden", p.dataset.panel !== name));
			loaders[name]?.();
		};
		tabs.forEach((t) => t.addEventListener("click", () => activate(t.dataset.tab!)));
		activate("events");
	}

	function setupLogout() {
		document.getElementById("logout-btn")!.addEventListener("click", () => {
			clearToken();
			window.location.href = "/login";
		});
	}

	/* --------------------------- Events --------------------------- */
	const eventForm = document.getElementById("event-form") as HTMLFormElement;

	function fmtRange(start: string, end: string) {
		const f = (s: string) => {
			const d = new Date(s);
			return isNaN(d.getTime())
				? s
				: d.toLocaleString("de-DE", { dateStyle: "medium", timeStyle: "short" });
		};
		return `${f(start)} – ${f(end)}`;
	}

	async function loadEvents() {
		const list = document.getElementById("event-list")!;
		list.innerHTML = '<p class="text-muted text-sm">Lade…</p>';
		try {
			const events: any[] = await getEvents();
			if (!events.length) {
				list.innerHTML = '<p class="text-muted text-sm">Noch keine Events.</p>';
				return;
			}
			list.innerHTML = events
				.map(
					(e) => `
				<div class="bg-surface border border-line rounded-ui-lg p-4 flex flex-wrap items-start justify-between gap-3">
					<div>
						<h3 class="font-medium">${esc(e.title)}</h3>
						<p class="text-sm text-muted">${esc(fmtRange(e.start_time, e.end_time))}</p>
						${e.location ? `<p class="text-sm text-muted">📍 ${esc(e.location)}</p>` : ""}
						${e.description ? `<p class="text-sm mt-1">${esc(e.description)}</p>` : ""}
					</div>
					<div class="flex gap-2">
						<button class="btn-edit-event inline-flex items-center justify-center px-3 py-1.5 rounded-ui text-sm border border-line hover:bg-surface-2 cursor-pointer" data-id="${e.id}">Bearbeiten</button>
						<button class="btn-del-event inline-flex items-center justify-center px-3 py-1.5 rounded-ui text-sm border border-line text-red-500 hover:bg-red-500/10 cursor-pointer" data-id="${e.id}">Löschen</button>
					</div>
				</div>`
				)
				.join("");

			list.querySelectorAll<HTMLButtonElement>(".btn-del-event").forEach((b) =>
				b.addEventListener("click", async () => {
					if (!confirm("Event wirklich löschen?")) return;
					try {
						await deleteEvent(Number(b.dataset.id));
						showFlash("Event gelöscht.");
						loadEvents();
					} catch (err) {
						showFlash((err as Error).message, false);
					}
				})
			);
			list.querySelectorAll<HTMLButtonElement>(".btn-edit-event").forEach((b) =>
				b.addEventListener("click", () => {
					const ev = events.find((x) => String(x.id) === b.dataset.id);
					fillEventForm(ev);
				})
			);
		} catch (err) {
			list.innerHTML = `<p class="text-sm text-red-500">${esc((err as Error).message)}</p>`;
		}
	}

	function toLocalInput(value: string) {
		const d = new Date(value);
		if (isNaN(d.getTime())) return value?.slice(0, 16) ?? "";
		const pad = (n: number) => String(n).padStart(2, "0");
		return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
	}

	function fillEventForm(ev: any) {
		field(eventForm, "id").value = ev.id;
		field(eventForm, "title").value = ev.title ?? "";
		eventForm.start_time.value = toLocalInput(ev.start_time);
		eventForm.end_time.value = toLocalInput(ev.end_time);
		eventForm.location.value = ev.location ?? "";
		eventForm.host_name.value = ev.host_name ?? "";
		eventForm.description.value = ev.description ?? "";
		document.getElementById("event-form-title")!.textContent = "Event bearbeiten";
		eventForm.scrollIntoView({ behavior: "smooth", block: "center" });
	}

	function setupEvents() {
		eventForm.querySelector("[data-reset]")!.addEventListener("click", () => {
			eventForm.reset();
			field(eventForm, "id").value = "";
			document.getElementById("event-form-title")!.textContent = "Neues Event";
		});
		eventForm.addEventListener("submit", async (e) => {
			e.preventDefault();
			const payload = {
				title: field(eventForm, "title").value.trim(),
				start_time: eventForm.start_time.value,
				end_time: eventForm.end_time.value,
				location: eventForm.location.value.trim() || null,
				host_name: eventForm.host_name.value.trim() || null,
				description: eventForm.description.value.trim() || null,
			};
			try {
				if (field(eventForm, "id").value) {
					await updateEvent(Number(field(eventForm, "id").value), payload);
					showFlash("Event aktualisiert.");
				} else {
					await createEvent(payload);
					showFlash("Event erstellt.");
				}
				eventForm.reset();
				field(eventForm, "id").value = "";
				document.getElementById("event-form-title")!.textContent = "Neues Event";
				loadEvents();
			} catch (err) {
				showFlash((err as Error).message, false);
			}
		});
	}

	/* -------------------------- Inventar -------------------------- */
	const invForm = document.getElementById("inv-form") as HTMLFormElement;

	async function loadInventory() {
		const list = document.getElementById("inv-list")!;
		list.innerHTML = '<p class="text-muted text-sm">Lade…</p>';
		try {
			const items: any[] = await getInventory();
			if (!items.length) {
				list.innerHTML = '<p class="text-muted text-sm">Noch keine Artikel.</p>';
				return;
			}
			list.innerHTML = items
				.map(
					(i) => `
				<div class="bg-surface border border-line rounded-ui-lg p-4 flex flex-wrap items-start justify-between gap-3">
					<div>
						<h3 class="font-medium">${esc(i.name)} <span class="text-muted text-sm">· ${esc(i.category)}</span></h3>
						<p class="text-sm text-muted">Bestand: ${esc(i.quantity_available)}/${esc(i.quantity)}${i.is_for_borrow ? "" : " · nicht verleihbar"}</p>
						${i.description ? `<p class="text-sm mt-1">${esc(i.description)}</p>` : ""}
					</div>
					<div class="flex gap-2">
						<button class="btn-edit-inv inline-flex items-center justify-center px-3 py-1.5 rounded-ui text-sm border border-line hover:bg-surface-2 cursor-pointer" data-id="${i.id}">Bearbeiten</button>
						<button class="btn-del-inv inline-flex items-center justify-center px-3 py-1.5 rounded-ui text-sm border border-line text-red-500 hover:bg-red-500/10 cursor-pointer" data-id="${i.id}">Löschen</button>
					</div>
				</div>`
				)
				.join("");

			list.querySelectorAll<HTMLButtonElement>(".btn-del-inv").forEach((b) =>
				b.addEventListener("click", async () => {
					if (!confirm("Artikel wirklich löschen?")) return;
					try {
						await deleteInventoryItem(Number(b.dataset.id));
						showFlash("Artikel gelöscht.");
						loadInventory();
					} catch (err) {
						showFlash((err as Error).message, false);
					}
				})
			);
			list.querySelectorAll<HTMLButtonElement>(".btn-edit-inv").forEach((b) =>
				b.addEventListener("click", () => {
					const it = items.find((x) => String(x.id) === b.dataset.id);
					fillInvForm(it);
				})
			);
		} catch (err) {
			list.innerHTML = `<p class="text-sm text-red-500">${esc((err as Error).message)}</p>`;
		}
	}

	function fillInvForm(it: any) {
		field(invForm, "id").value = it.id;
		field(invForm, "name").value = it.name ?? "";
		invForm.category.value = it.category ?? "";
		invForm.quantity.value = it.quantity ?? 0;
		invForm.picture_url.value = it.picture_url ?? "";
		invForm.description.value = it.description ?? "";
		(invForm.is_for_borrow as HTMLInputElement).checked = !!it.is_for_borrow;
		document.getElementById("inv-form-title")!.textContent = "Artikel bearbeiten";
		invForm.scrollIntoView({ behavior: "smooth", block: "center" });
	}

	function setupInventory() {
		invForm.querySelector("[data-reset]")!.addEventListener("click", () => {
			invForm.reset();
			field(invForm, "id").value = "";
			(invForm.is_for_borrow as HTMLInputElement).checked = true;
			document.getElementById("inv-form-title")!.textContent = "Neuer Inventar-Artikel";
		});
		invForm.addEventListener("submit", async (e) => {
			e.preventDefault();
			const payload = {
				name: field(invForm, "name").value.trim(),
				category: invForm.category.value.trim(),
				quantity: Number(invForm.quantity.value),
				picture_url: invForm.picture_url.value.trim() || null,
				description: invForm.description.value.trim() || null,
				is_for_borrow: (invForm.is_for_borrow as HTMLInputElement).checked,
			};
			try {
				if (field(invForm, "id").value) {
					await updateInventoryItem(Number(field(invForm, "id").value), payload);
					showFlash("Artikel aktualisiert.");
				} else {
					await createInventoryItem(payload);
					showFlash("Artikel erstellt.");
				}
				invForm.reset();
				field(invForm, "id").value = "";
				(invForm.is_for_borrow as HTMLInputElement).checked = true;
				document.getElementById("inv-form-title")!.textContent = "Neuer Inventar-Artikel";
				loadInventory();
			} catch (err) {
				showFlash((err as Error).message, false);
			}
		});
	}

	/* ----------------------- Boardmitglieder ----------------------- */
	const boardForm = document.getElementById("board-form") as HTMLFormElement;

	async function loadBoard() {
		const list = document.getElementById("board-list")!;
		list.innerHTML = '<p class="text-muted text-sm">Lade…</p>';
		try {
			const members: any[] = await getAllBoardMembers();
			if (!members.length) {
				list.innerHTML = '<p class="text-muted text-sm">Noch keine Boardmitglieder.</p>';
				return;
			}
			list.innerHTML = members
				.map(
					(m) => `
				<div class="bg-surface border border-line rounded-ui-lg p-4 flex flex-wrap items-start justify-between gap-3">
					<div class="flex items-center gap-3">
						${m.image_path ? `<img src="${esc(m.image_path)}" alt="${esc(m.name)}" class="size-10 rounded-full object-cover border border-line" />` : `<div class="size-10 rounded-full bg-surface-2 border border-line grid place-items-center text-xs text-muted">Foto</div>`}
						<div>
							<h3 class="font-medium">${esc(m.name)} <span class="text-muted text-sm font-normal">· ${esc(m.position)}</span></h3>
							${m.description ? `<p class="text-sm text-muted">${esc(m.description)}</p>` : ""}
							<p class="text-xs text-muted mt-0.5">Reihenfolge: ${esc(m.sort_order)} · ${m.visible ? "sichtbar" : "<span class='text-red-400'>versteckt</span>"}</p>
						</div>
					</div>
					<div class="flex gap-2">
						<button class="btn-edit-board inline-flex items-center justify-center px-3 py-1.5 rounded-ui text-sm border border-line hover:bg-surface-2 cursor-pointer" data-id="${m.id}">Bearbeiten</button>
						<button class="btn-del-board inline-flex items-center justify-center px-3 py-1.5 rounded-ui text-sm border border-line text-red-500 hover:bg-red-500/10 cursor-pointer" data-id="${m.id}">Löschen</button>
					</div>
				</div>`
				)
				.join("");

			list.querySelectorAll<HTMLButtonElement>(".btn-del-board").forEach((b) =>
				b.addEventListener("click", async () => {
					if (!confirm("Boardmitglied wirklich löschen?")) return;
					try {
						await deleteBoardMember(Number(b.dataset.id));
						showFlash("Boardmitglied gelöscht.");
						loadBoard();
					} catch (err) {
						showFlash((err as Error).message, false);
					}
				})
			);
			list.querySelectorAll<HTMLButtonElement>(".btn-edit-board").forEach((b) =>
				b.addEventListener("click", () => {
					const m = members.find((x) => String(x.id) === b.dataset.id);
					fillBoardForm(m);
				})
			);
		} catch (err) {
			list.innerHTML = `<p class="text-sm text-red-500">${esc((err as Error).message)}</p>`;
		}
	}

	const boardImgFile = document.getElementById("board-img-file") as HTMLInputElement;
	const boardImgPreview = document.getElementById("board-img-preview") as HTMLImageElement;

	function setBoardPreview(url: string) {
		if (url) {
			boardImgPreview.src = url;
			boardImgPreview.classList.remove("hidden");
		} else {
			boardImgPreview.src = "";
			boardImgPreview.classList.add("hidden");
		}
	}

	function fillBoardForm(m: any) {
		field(boardForm, "id").value = m.id;
		field(boardForm, "name").value = m.name ?? "";
		field(boardForm, "position").value = m.position ?? "";
		boardForm.description.value = m.description ?? "";
		field(boardForm, "image_path").value = m.image_path ?? "";
		boardForm.sort_order.value = m.sort_order ?? 0;
		(boardForm.visible as HTMLInputElement).checked = !!m.visible;
		setBoardPreview(m.image_path ? `http://localhost:3000${m.image_path}` : "");
		boardImgFile.value = "";
		document.getElementById("board-form-title")!.textContent = "Boardmitglied bearbeiten";
		boardForm.scrollIntoView({ behavior: "smooth", block: "center" });
	}

	function resetBoardForm() {
		boardForm.reset();
		field(boardForm, "id").value = "";
		field(boardForm, "image_path").value = "";
		(boardForm.visible as HTMLInputElement).checked = true;
		setBoardPreview("");
		document.getElementById("board-form-title")!.textContent = "Neues Boardmitglied";
	}

	function setupBoard() {
		boardImgFile.addEventListener("change", () => {
			const file = boardImgFile.files?.[0];
			if (file) setBoardPreview(URL.createObjectURL(file));
		});

		boardForm.querySelector("[data-reset]")!.addEventListener("click", resetBoardForm);

		boardForm.addEventListener("submit", async (e) => {
			e.preventDefault();

			let imagePath = field(boardForm, "image_path").value || null;

			const file = boardImgFile.files?.[0];
			if (file) {
				try {
					const { url } = await uploadBoardMemberImage(file);
					imagePath = url;
				} catch (err) {
					showFlash(`Bild-Upload fehlgeschlagen: ${(err as Error).message}`, false);
					return;
				}
			}

			const payload = {
				name: field(boardForm, "name").value.trim(),
				position: field(boardForm, "position").value.trim(),
				description: boardForm.description.value.trim() || null,
				image_path: imagePath,
				sort_order: Number(boardForm.sort_order.value) || 0,
				visible: (boardForm.visible as HTMLInputElement).checked,
			};
			try {
				if (field(boardForm, "id").value) {
					await updateBoardMember(Number(field(boardForm, "id").value), payload);
					showFlash("Boardmitglied aktualisiert.");
				} else {
					await createBoardMember(payload);
					showFlash("Boardmitglied erstellt.");
				}
				resetBoardForm();
				loadBoard();
			} catch (err) {
				showFlash((err as Error).message, false);
			}
		});
	}

	/* ------------------------ Öffnungszeiten ----------------------- */
	const WEEKDAYS = [
		[1, "Montag"],
		[2, "Dienstag"],
		[3, "Mittwoch"],
		[4, "Donnerstag"],
		[5, "Freitag"],
		[6, "Samstag"],
		[0, "Sonntag"],
	] as const;

	async function loadHours() {
		const list = document.getElementById("hours-list")!;
		list.innerHTML = '<p class="text-muted text-sm">Lade…</p>';
		try {
			const rows: any[] = await getOpeningHours();
			const byDay = new Map(rows.map((r) => [r.weekday, r]));
			list.innerHTML = WEEKDAYS.map(([wd, name]) => {
				const r = byDay.get(wd) ?? { open_time: "", close_time: "" };
				return `
				<div class="flex flex-wrap items-center gap-3" data-weekday="${wd}">
					<span class="w-28 text-sm font-medium">${name}</span>
					<input type="time" value="${esc(r.open_time)}" class="open bg-surface-2 border border-line rounded-ui px-3 py-1.5 text-sm outline-none focus:border-accent" />
					<span class="text-muted">–</span>
					<input type="time" value="${esc(r.close_time)}" class="close bg-surface-2 border border-line rounded-ui px-3 py-1.5 text-sm outline-none focus:border-accent" />
					<button class="btn-save-hours inline-flex items-center justify-center px-3 py-1.5 rounded-ui text-sm border border-line hover:bg-surface-2 cursor-pointer">Speichern</button>
				</div>`;
			}).join("");

			list.querySelectorAll<HTMLDivElement>("[data-weekday]").forEach((row) => {
				row.querySelector<HTMLButtonElement>(".btn-save-hours")!.addEventListener("click", async () => {
					const wd = Number(row.dataset.weekday);
					const open = (row.querySelector(".open") as HTMLInputElement).value || "00:00";
					const close = (row.querySelector(".close") as HTMLInputElement).value || "00:00";
					try {
						await updateOpeningHours(wd, open, close);
						showFlash("Öffnungszeiten gespeichert.");
					} catch (err) {
						showFlash((err as Error).message, false);
					}
				});
			});
		} catch (err) {
			list.innerHTML = `<p class="text-sm text-red-500">${esc((err as Error).message)}</p>`;
		}
	}

	/* -------------------------- Mitglieder ------------------------- */
	const userForm = document.getElementById("user-form") as HTMLFormElement;

	async function loadUsers() {
		const list = document.getElementById("user-list")!;
		list.innerHTML = '<p class="text-muted text-sm">Lade…</p>';
		try {
			const users: any[] = await getUsers();
			list.innerHTML = `
				<table class="w-full text-sm">
					<thead>
						<tr class="text-left text-muted border-b border-line">
							<th class="py-2 pr-3">Name</th>
							<th class="py-2 pr-3">Benutzername</th>
							<th class="py-2 pr-3">E-Mail</th>
							<th class="py-2 pr-3">Rolle</th>
							<th class="py-2"></th>
						</tr>
					</thead>
					<tbody>
						${users
							.map(
								(u) => `
							<tr class="border-b border-line/60" data-username="${esc(u.username)}">
								<td class="py-2 pr-3">${esc(u.prename)} ${esc(u.surname)}</td>
								<td class="py-2 pr-3">${esc(u.username)}</td>
								<td class="py-2 pr-3 text-muted">${esc(u.email)}</td>
								<td class="py-2 pr-3">
									<select class="role-select bg-surface-2 border border-line rounded-ui px-2 py-1 text-sm">
										${["admin", "contributor", "member"]
											.map(
												(r) => `<option value="${r}" ${u.role === r ? "selected" : ""}>${r}</option>`
											)
											.join("")}
									</select>
								</td>
								<td class="py-2 text-right">
									<button class="btn-del-user inline-flex items-center justify-center px-3 py-1 rounded-ui text-sm border border-line text-red-500 hover:bg-red-500/10 cursor-pointer">Löschen</button>
								</td>
							</tr>`
							)
							.join("")}
					</tbody>
				</table>`;

			list.querySelectorAll<HTMLTableRowElement>("[data-username]").forEach((row) => {
				const username = row.dataset.username!;
				row.querySelector<HTMLSelectElement>(".role-select")!.addEventListener("change", async (e) => {
					const newRole = (e.target as HTMLSelectElement).value;
					try {
						await changeUserRole(username, newRole);
						showFlash(`Rolle von ${username} → ${newRole}.`);
					} catch (err) {
						showFlash((err as Error).message, false);
						loadUsers();
					}
				});
				row.querySelector<HTMLButtonElement>(".btn-del-user")!.addEventListener("click", async () => {
					if (!confirm(`Mitglied "${username}" wirklich löschen?`)) return;
					try {
						await deleteUser(username);
						showFlash("Mitglied gelöscht.");
						loadUsers();
					} catch (err) {
						showFlash((err as Error).message, false);
					}
				});
			});
		} catch (err) {
			list.innerHTML = `<p class="text-sm text-red-500">${esc((err as Error).message)}</p>`;
		}
	}

	function setupUsers() {
		userForm.addEventListener("submit", async (e) => {
			e.preventDefault();
			const payload = {
				prename: userForm.prename.value.trim(),
				surname: userForm.surname.value.trim(),
				email: userForm.email.value.trim(),
				username: userForm.username.value.trim(),
				password: userForm.password.value,
			};
			try {
				await registerUser(payload);
				showFlash("Mitglied angelegt.");
				userForm.reset();
				loadUsers();
			} catch (err) {
				showFlash((err as Error).message, false);
			}
		});
	}

	function setupHours() {
		/* nichts vorzubereiten – wird beim Tab-Wechsel geladen */
	}

	boot();
</script>
