---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Card from "../components/ui/Card.astro";
import Badge from "../components/ui/Badge.astro";
import LocationCard from "../components/office/LocationCard.astro";
import { getOpeningHours } from "../lib/api/openingHours";

const room = {
	label: "FS-Büro",
	building: "Gebäude K · EG",
	detail: "Raum K003A",
};

let openingHoursData: Awaited<ReturnType<typeof getOpeningHours>> = [];
let today: (typeof openingHoursData)[number] | undefined;
let open = false;
let error: string | null = null;

const currentWeekday = new Date().getDay();

try {
	openingHoursData = await getOpeningHours();
	today = openingHoursData.find((day) => day.weekday === currentWeekday);

	if (today?.open_time && today?.close_time) {
		const [openHour, openMin] = today.open_time.split(":").map(Number);
		const [closeHour, closeMin] = today.close_time.split(":").map(Number);
		const now = new Date();
		const currentTime = now.getHours() * 60 + now.getMinutes();
		open = currentTime >= openHour * 60 + openMin && currentTime < closeHour * 60 + closeMin;
	}
} catch (e) {
	error = e instanceof Error ? e.message : "Fehler beim Laden der Öffnungszeiten";
}
---

<Layout title="Öffnungszeiten">
	<PageHeader
		eyebrow={room.label}
		title="Öffnungszeiten"
		description="Komm einfach vorbei – während der Öffnungszeiten ist immer jemand aus der Fachschaft da. Für Equipment-Rückgabe, Beratung oder einfach die Pause genießen am besten in diesen Zeiten:"
	/>

	<div class="grid lg:grid-cols-2 gap-6 items-start">
		<!-- Öffnungszeiten-Liste -->
		<Card class="p-2 sm:p-3">
			{
				error ? (
					<p class="text-red-500 p-4">{error}</p>
				) : (
					<ul>
						{openingHoursData.map((day) => {
							const isToday = day.weekday === currentWeekday;
							const closed = day.hours === null;
							return (
								<li
									class:list={[
										"flex items-center justify-between gap-3 px-4 py-4 rounded-ui",
										isToday && "bg-accent-soft",
									]}
								>
									<span class="flex items-center gap-3">
										{isToday && <Badge variant="solid">Heute</Badge>}
										<span class:list={["font-medium", isToday && "text-accent"]}>{day.name}</span>
									</span>
									<span
										class:list={[
											"font-mono text-sm",
											closed ? "text-muted" : isToday ? "text-accent" : "text-muted",
										]}
									>
										{closed ? "geschlossen" : day.hours}
									</span>
								</li>
							);
						})}
					</ul>
				)
			}
		</Card>

		<div class="flex flex-col gap-4">
			<!-- Aktueller Status -->
			<Card class="p-6">
				<p class:list={["flex items-center gap-2 font-medium", open ? "text-accent" : "text-muted"]}>
					<span class:list={["size-2.5 rounded-full", open ? "bg-accent" : "bg-muted"]}></span>
					{open ? "Gerade geöffnet" : "Gerade geschlossen"}
				</p>
				{today?.hours && <p class="text-muted font-mono text-sm mt-1">Heute {today.hours}</p>}
				{!today?.hours && <p class="text-muted font-mono text-sm mt-1">Heute geschlossen</p>}
			</Card>

			<LocationCard />

			<p class="text-muted text-sm leading-relaxed px-1">
				Außerhalb der Zeiten erreichst du uns jederzeit per <a href="fse@rwu.de" class="text-accent hover:underline">Mail</a> oder <a href="https://www.instagram.com/fachschaft/" class="text-accent hover:underline">Instagram</a>. In der
				vorlesungsfreien Zeit gelten Sonderzeiten.
			</p>
		</div>
	</div>
</Layout>
