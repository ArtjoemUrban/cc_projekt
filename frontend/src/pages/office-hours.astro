---
// Generiert mit Claude Opus 4.8
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Card from "../components/ui/Card.astro";
import Icon from "../components/ui/Icon.astro";
import OpeningHoursList from "../components/office/OpeningHoursList.astro";
import { getOpeningHours } from "../lib/api/openingHours";

const room = {
	label: "FS-Büro",
	building: "Gebäude K · EG",
	detail: "Raum K003A",
	// später vlt Lageplan wäre cool
};

// Hole echte Öffnungszeiten vom Backend
let openingHoursData: any[] = [];
let today: any = null;
let open = false;

try {
	openingHoursData = await getOpeningHours();
	
	// Aktueller Wochentag
	const now = new Date();
	const currentWeekday = now.getDay(); // 0=So, 1=Mo, ..., 6=Sa
	
	// Finde heute's Öffnungszeiten
	today = openingHoursData.find((day) => day.weekday === currentWeekday);
	
	// Prüfe ob gerade offen
	if (today && today.open_time && today.close_time) {
		const [openHour, openMin] = today.open_time.split(":").map(Number);
		const [closeHour, closeMin] = today.close_time.split(":").map(Number);
		
		const currentTime = now.getHours() * 60 + now.getMinutes();
		const openTime = openHour * 60 + openMin;
		const closeTime = closeHour * 60 + closeMin;
		
		open = currentTime >= openTime && currentTime < closeTime;
	}
} catch (error) {
	console.error("Failed to fetch opening hours:", error);
}
---

<Layout title="Öffnungszeiten">
	<PageHeader
		eyebrow={room.label}
		title="Öffnungszeiten"
		description="Komm einfach vorbei – während der Öffnungszeiten ist immer jemand aus der Fachschaft da. Für Equipment-Rückgabe, Beratung oder einfch  die Pause genießen am besten in diesen Zeiten:"
	/>

	<div class="grid lg:grid-cols-2 gap-6 items-start">
		<OpeningHoursList />

		<div class="flex flex-col gap-4">
			<!-- Aktueller Status -->
			<Card class="p-6">
				<p class:list={["flex items-center gap-2 font-medium", open ? "text-accent" : "text-muted"]}>
					<span class:list={["size-2.5 rounded-full", open ? "bg-accent" : "bg-muted"]}></span>
					{open ? "Gerade geöffnet" : "Gerade geschlossen"}
				</p>
				{today?.hours && <p class="text-muted font-mono text-sm mt-1">Heute {today.hours}</p>}
				{!today?.hours && <p class="text-muted font-mono text-sm mt-1">Heute geschlossen</p>}
			</Card>

			<!-- Standort -->
			<Card class="p-6 flex items-start gap-4">
				<span class="grid place-items-center size-10 rounded-ui-sm bg-surface-2 border border-line text-accent shrink-0">
					<Icon name="pin" />
				</span>
				<div>
					<p class="font-semibold">{room.building}</p>
					<p class="text-muted text-sm">{room.detail}</p>
				</div>
			</Card>

			<p class="text-muted text-sm leading-relaxed px-1">
				Außerhalb der Zeiten erreichst du uns jederzeit per Mail oder Instagram. In der
				vorlesungsfreien Zeit gelten Sonderzeiten.
			</p>
		</div>
	</div>
</Layout>
