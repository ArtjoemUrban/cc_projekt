---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import MemberCard from "../components/members/MemberCard.astro";
import { members } from "../data/members";
---

<Layout title="Mitglieder">
	<PageHeader
		eyebrow="Das Team"
		title="Mitglieder"
		description="Diese Menschen halten die Fachschaft am Laufen – von Hochschulpolitik über Events bis zum Equipment-Verleih. Schreib uns einfach, wenn du Fragen hast oder mitmachen willst."
	/>

	<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
		{members.map((member) => <MemberCard member={member} />)}
	</div>
</Layout>
