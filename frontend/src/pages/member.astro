---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import MemberCard from "../components/members/MemberCard.astro";
import { getBoardMembers } from "../lib/api/boardMembers";

let members: Awaited<ReturnType<typeof getBoardMembers>> = [];
let error: string | null = null;

try {
	members = await getBoardMembers();
} catch (e) {
	error = e instanceof Error ? e.message : "Fehler beim Laden der Mitglieder";
}
---

<Layout title="Mitglieder">
	<PageHeader
		eyebrow="Das Team"
		title="Mitglieder"
		description="Diese Menschen halten die Fachschaft am Laufen – von Hochschulpolitik über Events bis zum Equipment-Verleih. Schreib uns einfach, wenn du Fragen hast oder mitmachen willst."
	/>

	<div
		id="lightbox"
		class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 backdrop-blur-sm"
		role="dialog"
		aria-modal="true"
	>
		<button
			id="lightbox-close"
			class="absolute top-4 right-4 text-white text-3xl leading-none font-bold hover:opacity-70 transition-opacity"
			aria-label="Schließen"
		>&times;</button>
		<img
			id="lightbox-img"
			src=""
			alt=""
			class="max-w-[90vw] max-h-[90vh] rounded-xl object-contain shadow-2xl"
		/>
	</div>

	{error ? (
		<p class="text-red-500">{error}</p>
	) : members.length === 0 ? (
		<p class="text-muted">Noch keine Mitglieder eingetragen.</p>
	) : (
		<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
			{members.map((member) => <MemberCard member={member} />)}
		</div>
	)}

<script>
	const lightbox = document.getElementById("lightbox")!;
	const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
	const closeBtn = document.getElementById("lightbox-close")!;

	function open(src: string, alt: string) {
		lightboxImg.src = src;
		lightboxImg.alt = alt;
		lightbox.classList.remove("hidden");
		lightbox.classList.add("flex");
		document.body.style.overflow = "hidden";
	}

	function close() {
		lightbox.classList.add("hidden");
		lightbox.classList.remove("flex");
		document.body.style.overflow = "";
	}

	document.querySelectorAll<HTMLImageElement>("[data-lightbox-src]").forEach((img) => {
		img.addEventListener("click", () => {
			open(img.dataset.lightboxSrc!, img.dataset.lightboxAlt ?? "");
		});
	});

	closeBtn.addEventListener("click", close);
	lightbox.addEventListener("click", (e) => {
		if (e.target === lightbox) close();
	});
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") close();
	});
</script>
</Layout>
